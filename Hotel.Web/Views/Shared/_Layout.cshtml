@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(string c, string? a = null) =>
        controlador == c && (a is null || accion == a) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md bg-white border-bottom">
            <div class="container">
                <a class="navbar-brand" asp-controller="Habitaciones" asp-action="Index">Hotel</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="menuPrincipal">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="@Activo("Habitaciones")" asp-controller="Habitaciones" asp-action="Index">Habitaciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="@Activo("Reservas", "Disponibles")" asp-controller="Reservas" asp-action="Disponibles">Disponibilidad</a>
                        </li>
                        <li class="nav-item">
                            <a class="@(controlador == "Reservas" && accion != "Disponibles" ? "nav-link active" : "nav-link")"
                               asp-controller="Reservas" asp-action="Index">Reservas</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-3">
        <main role="main">
            @if (TempData["Mensaje"] is string mensaje)
            {
                var tipo = TempData["Tipo"] as string;
                var clase = tipo is "error" or "eliminado" or "cancelado" ? "alert-danger"
                    : tipo == "advertencia" ? "alert-warning" : "alert-success";
                <div class="alert @clase" role="alert">
                    <strong>@(TempData["Titulo"] as string)</strong> @mensaje
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top py-3 text-center text-muted">
        <div class="container">&copy; 2026 - Hotel.Web</div>
    </footer>

    <div id="transicion" hidden>
        <div class="text-center">
            <p class="mt-3 mb-0">Cargando en <strong id="transicionSegundos">3</strong> s</p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/transicion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
