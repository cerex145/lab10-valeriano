@model Habitacion
@{
    ViewData["Title"] = "Nueva habitación";
}

<h1 class="h3 mb-3">Nueva habitación</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Numero" class="form-label">Número</label>
                <input asp-for="Numero" class="form-control" maxlength="10"
                       data-val-required="Indique el número de la habitación." />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoHabitacionId" class="form-label">Tipo de habitación</label>
                <select asp-for="TipoHabitacionId" asp-items="(SelectList)ViewBag.Tipos" class="form-select"
                        data-val-required="Seleccione un tipo de habitación.">
                    <option value="">-- Seleccione un tipo --</option>
                </select>
                <span asp-validation-for="TipoHabitacionId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Piso" class="form-label">Piso</label>
                <input asp-for="Piso" class="form-control" type="number" min="1" max="50"
                       data-val-required="Indique el piso." />
                <span asp-validation-for="Piso" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
